# Set in process environment or application-local.properties.
YOGA_DB_JDBC_URL=jdbc:postgresql://HOST_FROM_SUPABASE_CONNECT:6543/postgres?sslmode=require&prepareThreshold=0
YOGA_DB_USERNAME=USER_FROM_SUPABASE_CONNECT
YOGA_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SUPABASE_URL=https://cagwkxiccmayrtajwdtc.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_KEY
# Backend only: required to create/migrate staff accounts. Never expose in frontend.
SUPABASE_SERVICE_ROLE_KEY=
YOGA_CORS_ORIGINS=http://localhost:4300,http://127.0.0.1:4300
# PayOS (VietQR động). Để trống thì tắt thanh toán online. Không đưa khóa thật vào Git.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Webhook đăng ký trên PayOS: https://<backend>/api/v1/payment-webhooks/payos
YOGA_PAYMENT_RETURN_URL=http://localhost:4300/membership/pos
YOGA_PAYMENT_STUDENT_RETURN_URL=http://localhost:4300/membership/plans
YOGA_PAYMENT_STUDENT_COURSE_RETURN_URL=http://localhost:4300/schedule/courses
# Zoom (lớp học online). Server-to-Server OAuth app; để trống thì tắt vào lớp online.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Secret Token của Event Subscription. Webhook: https://<backend>/api/v1/integration-webhooks/zoom
ZOOM_WEBHOOK_SECRET=
# Email/user id Zoom làm host mặc định (khi phòng ảo chưa khai báo host riêng)
ZOOM_DEFAULT_HOST=me
# true (mặc định): link riêng từng học viên, cần Zoom Pro. false: link chung, để thử với Zoom Basic (giới hạn 40 phút).
ZOOM_USE_REGISTRATION=true
# Bunny Stream (thư viện video). Để trống thư viện/khóa thì tắt xem và tải video.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# Khóa "Embed view token authentication" của thư viện (bật tính năng này trên Bunny để URL trình phát có hạn)
BUNNY_TOKEN_KEY=
# Pull zone của thư viện, ví dụ vz-xxxx.b-cdn.net (ảnh thu nhỏ)
BUNNY_CDN_HOSTNAME=
# Bí mật của webhook: https://<backend>/api/v1/integration-webhooks/bunny?token=<BUNNY_WEBHOOK_SECRET>
BUNNY_WEBHOOK_SECRET=
# Số thiết bị xem video cùng lúc của một học viên
YOGA_CONTENT_MAX_DEVICES=2
# AI (Gemini) – AI_INTEGRATION_PLAN.md. Không đưa khóa thật vào Git.
# Chỉ cần 2 biến dưới là bật cả 4 tính năng (gợi ý chủ đề video, trợ lý số liệu, trợ lý học viên, trợ lý lễ tân/HLV)
# với mô hình mặc định gemini-3.5-flash-lite. Bật mà thiếu khóa thì backend không khởi động.
YOGA_AI_ENABLED=false
GEMINI_API_KEY=
# Trần chi phí AI toàn hệ thống mỗi ngày (USD); vượt thì tạm dừng AI đến 0h
YOGA_AI_DAILY_BUDGET_USD=20
# Tùy chọn – tắt riêng một tính năng: đặt biến MODEL của nó thành rỗng, ví dụ
# YOGA_AI_STUDENT_CHAT_MODEL=
# Tùy chọn – đổi mô hình: đặt MODEL và cả 3 giá USD/1M token theo bảng giá Google, ví dụ
# YOGA_AI_MANAGER_CHAT_MODEL=gemini-3.8-flash
# YOGA_AI_MANAGER_CHAT_PRICE_INPUT=0.75
# YOGA_AI_MANAGER_CHAT_PRICE_CACHED_INPUT=0.075
# YOGA_AI_MANAGER_CHAT_PRICE_OUTPUT=3.75
# (tiền tố cho từng tính năng: YOGA_AI_TAGGING_, YOGA_AI_MANAGER_CHAT_, YOGA_AI_STUDENT_CHAT_, YOGA_AI_STAFF_CHAT_)
