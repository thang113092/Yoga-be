# Set in process environment or application-local.properties.
YOGA_DB_JDBC_URL=jdbc:postgresql://HOST_FROM_SUPABASE_CONNECT:6543/postgres?sslmode=require&prepareThreshold=0
YOGA_DB_USERNAME=USER_FROM_SUPABASE_CONNECT
YOGA_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SUPABASE_URL=https://cagwkxiccmayrtajwdtc.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_KEY
# Backend only: required to create/migrate staff accounts. Never expose in frontend.
SUPABASE_SERVICE_ROLE_KEY=
YOGA_CORS_ORIGINS=http://localhost:4300,http://127.0.0.1:4300
# PayOS (VietQR động). Để trống thì tắt thanh toán online. Không đưa khóa thật vào Git.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Webhook đăng ký trên PayOS: https://<backend>/api/v1/payment-webhooks/payos
YOGA_PAYMENT_RETURN_URL=http://localhost:4300/membership/pos
YOGA_PAYMENT_STUDENT_RETURN_URL=http://localhost:4300/membership/plans
YOGA_PAYMENT_STUDENT_COURSE_RETURN_URL=http://localhost:4300/schedule/courses
# Zoom (lớp học online). Server-to-Server OAuth app; để trống thì tắt vào lớp online.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Secret Token của Event Subscription. Webhook: https://<backend>/api/v1/integration-webhooks/zoom
ZOOM_WEBHOOK_SECRET=
# Email/user id Zoom làm host mặc định (khi phòng ảo chưa khai báo host riêng)
ZOOM_DEFAULT_HOST=me
# true (mặc định): link riêng từng học viên, cần Zoom Pro. false: link chung, để thử với Zoom Basic (giới hạn 40 phút).
ZOOM_USE_REGISTRATION=true
